# Copy this file to .env and fill in real values.
# .env is gitignored — your real password never gets committed.

# Password for the web UI login. Change this from the default.
APP_PASSWORD=changeme

# Session cookie secret. Generate a new one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If left blank, a random key is generated per process, which logs you
# out every time the server restarts.
APP_SECRET_KEY=

# Discord webhook URL for new-job alerts. Leave blank to disable.
# Create one at: Discord > Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
